<Window x:Class="Wattkin.UI.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wattkin.UI"
        xmlns:l="clr-namespace:Wattkin"
        Title="{x:Static l:Strings.Install_Title}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Lc.Window}" Foreground="{DynamicResource Lc.Text}"
        FontFamily="{DynamicResource Lc.Font}" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <ui:BrandMark Width="34" Height="22" VerticalAlignment="Center" />
            <TextBlock Text="wattkin" FontFamily="{DynamicResource Lc.Display}" FontSize="26" FontWeight="SemiBold" Margin="12,0,0,2" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Headline" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Body" Style="{StaticResource Lc.Hint}" TextWrapping="Wrap" Margin="0,8,0,14" />
        <CheckBox x:Name="Autostart" Content="{x:Static l:Strings.Install_Autostart}" IsChecked="True" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Lc.Bad}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="InstallButton" Content="{x:Static l:Strings.Install_Install}" IsDefault="True" MinWidth="100" Click="OnInstall" Margin="0,0,8,0" />
            <Button Content="{x:Static l:Strings.Common_Cancel}" IsCancel="True" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
