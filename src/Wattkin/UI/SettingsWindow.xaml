<Window x:Class="Wattkin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wattkin.UI"
        xmlns:l="clr-namespace:Wattkin"
        Title="Wattkin" Width="920" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Lc.Window}" Foreground="{DynamicResource Lc.Text}"
        FontFamily="{DynamicResource Lc.Font}" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <!-- Expert: every control, in tabs. Simple: its own page (SimpleSettings). -->
    <Grid>
    <TabControl x:Name="Tabs" Margin="8" Background="Transparent" BorderThickness="0">

        <!-- ================= Battery ================= -->
        <TabItem Header="{x:Static l:Strings.Common_Battery}" Tag="battery">
            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                <StackPanel>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_Health}" Style="{StaticResource Lc.Section}" />
                            <UniformGrid Columns="4" Margin="0,0,0,8">
                                <StackPanel><TextBlock Text="{x:Static l:Strings.Battery_DesignCapacity}" Style="{StaticResource Lc.Label}" /><TextBlock x:Name="DesignText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel><TextBlock Text="{x:Static l:Strings.Battery_HoldsNow}" Style="{StaticResource Lc.Label}" /><TextBlock x:Name="FullText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel><TextBlock Text="{x:Static l:Strings.Common_Health}" Style="{StaticResource Lc.Label}" /><TextBlock x:Name="HealthText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                                <StackPanel><TextBlock Text="{x:Static l:Strings.Battery_Cycles}" Style="{StaticResource Lc.Label}" /><TextBlock x:Name="CyclesText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="BatteryDetails" Style="{StaticResource Lc.Hint}" Margin="0,0,0,8" />
                            <Border x:Name="CalibrationSuggestion" Visibility="Collapsed" BorderBrush="{DynamicResource Lc.Accent}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="CalibrationSuggestionText" Style="{StaticResource Lc.Value}" TextWrapping="Wrap" />
                                    <Button x:Name="CalibrationSuggestionButton" Content="{x:Static l:Strings.Battery_CalibrateNow}" Click="OnCalibrationStart" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <ui:CapacityChart x:Name="Chart" Height="170" Margin="0,4,0,4" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Text="{x:Static l:Strings.Battery_HistoryHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{x:Static l:Strings.Battery_OpenLogFolder}" Click="OnOpenBatteryLog" Margin="0,0,8,0" />
                                <Button Content="{x:Static l:Strings.Battery_RefreshHistory}" Click="OnRefreshHistory" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_ChargeLimit}" Style="{StaticResource Lc.Section}" />

                            <!-- Simple: one tap per limit; the controller restarts charging 10% below it. -->

                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static l:Strings.Common_StopChargingAt}" Style="{StaticResource Lc.Label}" />
                                    <Slider x:Name="StopSlider" Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" SmallChange="1" LargeChange="5" ValueChanged="OnLimitSliders" />
                                    <TextBlock x:Name="StopValue" Grid.Column="2" Style="{StaticResource Lc.Value}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <CheckBox x:Name="CustomResume" Content="{x:Static l:Strings.Battery_CustomResume}" Checked="OnLimitSliders" Unchecked="OnLimitSliders" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static l:Strings.Battery_StartChargingBelow}" Style="{StaticResource Lc.Label}" />
                                    <Slider x:Name="ResumeSlider" Grid.Column="1" Minimum="5" Maximum="99" SmallChange="1" LargeChange="5" ValueChanged="OnLimitSliders" />
                                    <TextBlock x:Name="ResumeValue" Grid.Column="2" Style="{StaticResource Lc.Value}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock x:Name="LimitExplain" Style="{StaticResource Lc.Hint}" Margin="0,4,0,8" />
                                <Button x:Name="ApplyLimit" Content="{x:Static l:Strings.Common_Apply}" Click="OnApplyLimit" HorizontalAlignment="Left" MinWidth="90" Margin="0,0,0,8" />
                            </StackPanel>
                            <TextBlock x:Name="ChargeStatusText" Style="{StaticResource Lc.Label}" Margin="0,6,0,0" />
                            <Separator Margin="0,12" />
                            <CheckBox x:Name="FullOnce" Content="{x:Static l:Strings.Battery_FullOnce}" Click="OnFullOnce" />
                            <StackPanel>
                                <CheckBox x:Name="Drain" Content="{x:Static l:Strings.Battery_Drain}" Click="OnDrain" />
                                <TextBlock Style="{StaticResource Lc.Hint}" Text="{x:Static l:Strings.Battery_DrainHint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Battery_Calibration}" Style="{StaticResource Lc.Section}" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Text="{x:Static l:Strings.Battery_CalibrationHint}" Margin="0,0,0,8" />
                            <TextBlock x:Name="CalibrationStatus" Style="{StaticResource Lc.Value}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ProgressBar x:Name="CalibrationBar" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,6" />
                            <TextBlock x:Name="CalibrationEta" Style="{StaticResource Lc.Label}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CalibrationStart" Content="{x:Static l:Strings.Battery_StartCalibration}" Click="OnCalibrationStart" Margin="0,0,8,0" />
                                <Button x:Name="CalibrationCancel" Content="{x:Static l:Strings.Common_Cancel}" Click="OnCalibrationCancel" Margin="0,0,16,0" />
                                <CheckBox x:Name="CalibrationFast" Content="{x:Static l:Strings.Battery_FastDischarge}" Click="OnCalibrationFast" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="CalibrationHistory" Style="{StaticResource Lc.Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Profiles ================= -->
        <TabItem Header="{x:Static l:Strings.Common_Profiles}" Tag="profiles">
            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                <StackPanel>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_Profiles}" Style="{StaticResource Lc.Section}" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,0,0,8" Text="{x:Static l:Strings.Profiles_Hint}" />
                            <ui:ProfileButtons x:Name="ProfileButtonsPanel" Margin="-2,0,-2,10" />
                            <StackPanel x:Name="ProfileSummaries" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Profiles_AutoSwitching}" Style="{StaticResource Lc.Section}" />
                            <CheckBox x:Name="AutoSwitch" Content="{x:Static l:Strings.Profiles_AutoSwitch}" Click="OnAutoChanged" />
                            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static l:Strings.Profiles_WhenPluggedIn}" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="AcProfile" Grid.Column="1" SelectionChanged="OnAutoChanged" /></Grid>
                            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="DcLabel" Text="{x:Static l:Strings.Common_OnBattery}" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="DcProfile" Grid.Column="1" SelectionChanged="OnAutoChanged" /></Grid>
                            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static l:Strings.Profiles_AtOrBelow}" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="LowThreshold" Grid.Column="1" SelectionChanged="OnAutoChanged" /><ComboBox x:Name="LowProfile" Grid.Column="2" Margin="8,0,0,0" SelectionChanged="OnAutoChanged" /></Grid>
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static l:Strings.Profiles_RulesHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static l:Strings.Profiles_RestoreWindows}" Click="OnRestoreWindowsPower" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static l:Strings.Profiles_RestoreWindowsHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Keyboard & keys ================= -->
        <TabItem Header="{x:Static l:Strings.Settings_TabKeyboard}" Tag="keyboard">
            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                <StackPanel>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Keyboard_Backlight}" Style="{StaticResource Lc.Section}" />
                            <WrapPanel x:Name="KbLevelPanel" Margin="0,0,0,10" />
                            <!-- Only where the keys are lit by an RGB controller over USB (Mystic Light). -->
                            <StackPanel x:Name="KbColorSection">
                                <TextBlock Text="{x:Static l:Strings.Common_Colour}" Style="{StaticResource Lc.Label}" Margin="0,0,0,6" />
                                <WrapPanel x:Name="KbColorPanel" Margin="-4,0,0,4" />
                                <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,0,0,10" Text="{x:Static l:Strings.Keyboard_MysticHint}" />
                            </StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_TurnOffWhenNotTyping}" Style="{StaticResource Lc.Label}" Margin="0,0,0,6" />
                            <WrapPanel x:Name="KbTimeoutPanel" />
                            <!-- Only where auto-off is Wattkin's own (USB light); the controller's is fixed at about 10 s. -->
                            <StackPanel x:Name="KbDelaySection" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{x:Static l:Strings.Keyboard_HowLong}" Style="{StaticResource Lc.Label}" Margin="0,0,10,0" />
                                <Border x:Name="KbDelayHost" />
                            </StackPanel>
                            <TextBlock x:Name="KbTimeoutHint" Style="{StaticResource Lc.Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Keyboard_KeysAndLights}" Style="{StaticResource Lc.Section}" />
                            <CheckBox x:Name="Hotkeys" Content="{x:Static l:Strings.Keyboard_Hotkeys}" Click="OnKeysChanged" />
                            <CheckBox x:Name="Osd" Content="{x:Static l:Strings.Keyboard_Osd}" Click="OnKeysChanged" />
                            <CheckBox x:Name="MuteLeds" Content="{x:Static l:Strings.Keyboard_MuteLeds}" Click="OnKeysChanged" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Text="{x:Static l:Strings.Keyboard_KeysHint}" />
                        </StackPanel>
                    </Border>
                    <!-- Only on laptops with an EC webcam switch (Cooler Boost is on the Debug tab and in profiles). -->
                    <Border x:Name="DevicesCard" Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Keyboard_Devices}" Style="{StaticResource Lc.Section}" />
                            <CheckBox x:Name="WebcamToggle" Content="{x:Static l:Strings.Keyboard_Webcam}" Click="OnWebcam" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Graphics ================= -->
        <TabItem Header="{x:Static l:Strings.Common_Graphics}" Tag="graphics">
            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                <StackPanel>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Graphics_GpuNow}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="DgpuNow" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="DgpuExplain" Style="{StaticResource Lc.Hint}" Margin="0,4,0,0" />
                            <!-- Simple: an idle RTX already powers down by itself; a button only when there's something to fix. -->
                        </StackPanel>
                    </Border>
                    <!-- Expert: only when the RTX was left disabled in Windows (older Wattkin, Device Manager). -->
                    <Border x:Name="DisabledCard" Style="{StaticResource Lc.Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Graphics_DisabledTitle}" Style="{StaticResource Lc.Section}" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,0,0,8" Text="{x:Static l:Strings.Graphics_DisabledHint}" />
                            <Button x:Name="ReEnableButton" Content="{x:Static l:Strings.Graphics_ReEnable}" Click="OnReEnable" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Graphics_FirmwareMode}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="FirmwareMode" Style="{StaticResource Lc.Value}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,0,0,8" Text="{x:Static l:Strings.Graphics_FirmwareHint}" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ModeHybrid" Content="{x:Static l:Strings.Graphics_SwitchHybrid}" Click="OnModeHybrid" Margin="0,0,8,0" />
                                <Button x:Name="ModeIntegrated" Content="{x:Static l:Strings.Graphics_SwitchIntegrated}" Click="OnModeIntegrated" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= System ================= -->
        <TabItem Header="{x:Static l:Strings.Settings_TabSystem}" Tag="system">
            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                <StackPanel>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.System_Live}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="LiveText" FontFamily="{DynamicResource Lc.Mono}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.System_ThisLaptop}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="InfoText" FontFamily="{DynamicResource Lc.Mono}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.System_BusiestApps}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="ProcessText" FontFamily="{DynamicResource Lc.Mono}" FontSize="12.5" Text="{x:Static l:Strings.Common_Measuring}" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,6,0,0" Text="{x:Static l:Strings.System_AppsHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= General ================= -->
        <TabItem Header="{x:Static l:Strings.Settings_TabGeneral}" Tag="general">
            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                <StackPanel>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="Wattkin" Style="{StaticResource Lc.Section}" />
                            <CheckBox x:Name="StartWithWindows" Content="{x:Static l:Strings.General_StartWithWindows}" Click="OnStartWithWindows" />
                            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static l:Strings.General_TrayShows}" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="TrayDisplayChoice" Grid.Column="1" SelectionChanged="OnTrayDisplay" /></Grid>
                            <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static l:Strings.Common_Language}" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="LanguageChoice" Grid.Column="1" SelectionChanged="OnLanguage" /></Grid>
                            <CheckBox x:Name="WidgetToggle" Content="{x:Static l:Strings.General_ShowWidget}" Click="OnWidgetToggle" />
                            <CheckBox x:Name="BatteryLogToggle" Content="{x:Static l:Strings.General_BatteryLog}" Click="OnGeneralChanged" />
                            <TextBlock x:Name="ElevationText" Style="{StaticResource Lc.Hint}" Margin="0,6,0,0" />
                            <Button x:Name="ElevateButton" Content="{x:Static l:Strings.Common_RestartAsAdmin}" Click="OnElevate" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- Shown in the simple view only while MSI Center is still running. -->
                    <Border x:Name="MsiCard" Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.General_ReplacingMsi}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="MsiStatus" Style="{StaticResource Lc.Value}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Lc.Hint}" TextWrapping="Wrap" Text="{x:Static l:Strings.General_MsiSteps}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.General_About}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="SupportText" Style="{StaticResource Lc.Value}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource Lc.Hint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= Debug ================= -->
        <TabItem Header="{x:Static l:Strings.Settings_TabDebug}" Tag="debug">
            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                <StackPanel>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_Fans}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="DebugFansNow" FontFamily="{DynamicResource Lc.Mono}" FontSize="12.5" Margin="0,0,0,4" />
                            <TextBlock x:Name="DebugTopSpeed" Style="{StaticResource Lc.Label}" Margin="0,0,0,10" />
                            <TextBlock Text="{x:Static l:Strings.Debug_ForceFans}" Style="{StaticResource Lc.Label}" Margin="0,0,0,6" />
                            <WrapPanel x:Name="FanForcePanel" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,0,0,10" Text="{x:Static l:Strings.Debug_ForceHint}" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MeasureFansButton" Content="{x:Static l:Strings.Debug_MeasureTopSpeed}" Click="OnMeasureFans" Margin="0,0,8,0" />
                                <Button x:Name="CompareFansButton" Content="{x:Static l:Strings.Debug_CompareFans}" Click="OnCompareFans" />
                            </StackPanel>
                            <TextBlock x:Name="FanTestText" Style="{StaticResource Lc.Value}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Debug_BatteryCharger}" Style="{StaticResource Lc.Section}" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,0,0,8" Text="{x:Static l:Strings.Debug_RunOnBatteryHint}" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RunOnBatteryButton" Content="{x:Static l:Strings.Debug_RunOnBattery}" Click="OnRunOnBattery" Margin="0,0,8,0" />
                                <Button x:Name="StopOnBatteryButton" Content="{x:Static l:Strings.Common_Stop}" Click="OnStopOnBattery" />
                            </StackPanel>
                            <TextBlock x:Name="OnBatteryText" Style="{StaticResource Lc.Value}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Debug_LightsMessages}" Style="{StaticResource Lc.Section}" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TestLightsButton" Content="{x:Static l:Strings.Debug_FlashLights}" Click="OnTestLights" Margin="0,0,8,0" />
                                <Button Content="{x:Static l:Strings.Debug_TestMessage}" Click="OnTestOsd" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Debug_Registers}" Style="{StaticResource Lc.Section}" />
                            <TextBlock x:Name="RegistersText" FontFamily="{DynamicResource Lc.Mono}" FontSize="12.5" TextWrapping="Wrap" Text="{x:Static l:Strings.Common_Reading}" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,6,0,0" Text="{x:Static l:Strings.Debug_RegistersHint}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lc.Card}">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Common_Diagnostics}" Style="{StaticResource Lc.Section}" />
                            <TextBlock Style="{StaticResource Lc.Hint}" Margin="0,0,0,8" Text="{x:Static l:Strings.Debug_DiagnosticsHint}" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DiagnosticsButton" Content="{x:Static l:Strings.Debug_SaveReport}" Click="OnDiagnostics" Margin="0,0,8,0" />
                                <Button Content="{x:Static l:Strings.Debug_OpenLog}" Click="OnOpenLog" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

    <ui:SimpleSettings x:Name="Simple" Visibility="Collapsed" />

    <!-- On the tab strip's empty right side. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,20,0">
        <TextBlock Text="{x:Static l:Strings.Settings_View}" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <RadioButton x:Name="SimpleViewButton" Content="{x:Static l:Strings.Settings_Simple}" GroupName="view" Style="{StaticResource Lc.Segment}" Checked="OnViewChanged" />
        <RadioButton x:Name="ExpertViewButton" Content="{x:Static l:Strings.Settings_Expert}" GroupName="view" Style="{StaticResource Lc.Segment}" Checked="OnViewChanged" />
    </StackPanel>
    </Grid>
</Window>
