<Window x:Class="Wattkin.UI.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wattkin.UI"
        Title="Edit profile" Width="780" Height="860" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Lc.Window}" Foreground="{DynamicResource Lc.Text}"
        FontFamily="{DynamicResource Lc.Font}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <!-- One profile slot: everything it sets. The gear on a profile button opens this. -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" Padding="12,10,16,0">
            <StackPanel>
                <Border Style="{StaticResource Lc.Card}">
                    <StackPanel>
                        <TextBlock x:Name="SlotTitle" Style="{StaticResource Lc.Section}" />
                        <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><TextBox x:Name="NameBox" Grid.Column="1" MaxLength="24" /></Grid>
                        <TextBlock Style="{StaticResource Lc.Hint}" Text="Shown on the profile buttons, in the flyout and in Settings. Each setting below can be left as it is." Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Lc.Card}">
                    <StackPanel>
                        <TextBlock Text="Processor" Style="{StaticResource Lc.Section}" />
                        <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Power limits (MSI)" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="ShiftBox" Grid.Column="1" /></Grid>
                        <TextBlock Style="{StaticResource Lc.Hint}" Margin="190,0,0,6" TextWrapping="Wrap" Text="MSI's firmware mode: how many watts the processor may draw, sustained (PL1) and in bursts (PL2). The self-test measures them. Leave as is if the BIOS or ThrottleStop sets the limits; then leave turbo and the maximum state as they are too." />
                        <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Turbo boost" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="TurboBox" Grid.Column="1" /></Grid>
                        <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum processor state" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="MaxCpuBox" Grid.Column="1" /></Grid>
                        <TextBlock Style="{StaticResource Lc.Hint}" Margin="190,0,0,0" TextWrapping="Wrap" Text="Both are Windows settings of the active power plan, on the charger and on battery. Below 100%, the processor never turbos either." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Lc.Card}">
                    <StackPanel>
                        <TextBlock Text="Fans" Style="{StaticResource Lc.Section}" />
                        <UniformGrid x:Name="FanModePanel" Rows="1" Margin="-2,0,-2,8" />
                        <TextBlock x:Name="FanHint" Style="{StaticResource Lc.Hint}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <CheckBox x:Name="CoolerBoostBox" Content="Full speed (Cooler Boost), whatever the mode says" Margin="0,2,0,6" />
                        <StackPanel x:Name="CurvePanel">
                            <TextBlock x:Name="CurveIntro" Style="{StaticResource Lc.Hint}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <ui:FanTableEditor x:Name="TableEditor" />
                            <ui:FanCurveEditor x:Name="SpeedsEditor" Visibility="Collapsed" />
                            <TextBlock x:Name="CurveProblem" Foreground="{DynamicResource Lc.Bad}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="LaptopCurveButton" Content="Use the laptop's curve" Click="OnLaptopCurve" Margin="0,0,12,0" />
                                <CheckBox x:Name="UnrestrictedBox" Content="Allow curves that let the laptop run hot (experimental)" VerticalAlignment="Center" Click="OnUnrestricted" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Lc.Card}">
                    <StackPanel>
                        <TextBlock Text="Screen and keyboard" Style="{StaticResource Lc.Section}" />
                        <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Built-in screen refresh rate" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="RefreshBox" Grid.Column="1" /></Grid>
                        <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Keyboard light" Style="{StaticResource Lc.Label}" VerticalAlignment="Center" /><ComboBox x:Name="KeyboardBox" Grid.Column="1" /></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="16,8,16,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Reset to default…" Click="OnReset" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="90" Click="OnCancel" />
            <Button DockPanel.Dock="Right" Content="Apply and close" IsDefault="True" Click="OnApplyAndClose" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Apply" MinWidth="90" Click="OnApply" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
